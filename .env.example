# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillbridge_ai?retryWrites=true&w=majority

# Flask Secret Key for Sessions
SECRET_KEY=change_this_to_a_secure_random_string_32_chars

# Default Initial Admin Credentials
ADMIN_EMAIL=admin@skillbridge.ai
ADMIN_PASSWORD=AdminPassword123!

# Application Port (Render automatically sets this)
PORT=5001
